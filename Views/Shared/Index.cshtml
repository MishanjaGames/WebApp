@model IEnumerable<WebApp.Itm>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_L-Sh";
    ViewData["Title"] = "<title>...<title>";
}
<link rel="stylesheet" src=""/>
<h2>Home Page</h2>
<div class="usr-mng">
@{
    if (User.Identity.IsAuthenticated)
    {
        <h5>Hello, @User.Identity.Name</h5>
        <a class="btn btn-primary" asp-controller="I" asp-action="Index">Shop</a>
        <a class="btn btn-success" asp-controller="U" asp-action="Index">Profile</a>
        <a class="btn btn-danger" asp-controller="U" asp-action="SignOut">Sign Out</a>
    }
    else
    {
        <a class="btn btn-primary" asp-controller="I" asp-action="Index">Shop</a>
        <a class="btn btn-success" asp-controller="U" asp-action="Log">Login</a>
    }
}
</div>