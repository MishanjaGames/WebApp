@model IEnumerable<WebApp.UsrTbl>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_L-u";
    ViewData["Title"] = "<>...</>";
}
<a class="btn btn-primary" asp-controller="h" asp-action="Index">Return To Main Page</a>
<h2>Products</h2>
<div>
    <a asp-controller="U" asp-action="Add" class="btn btn-primary">Add User</a>
</div>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Email</th>
            <th scope="col">Role</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Id</td>
                    <td>@u.User.UserName</td>
                    <td>@u.User.Email</td>
                    @if (u.Roles[0] == "")
                    {
                        <td>None Assigned</td>
                    }
                    else
                    {
                        <td>
                            @foreach (var r in u.Roles)
                            {
                                <p>@r</p>
                            }
                        </td>
                    }
                    <td>Edit Roles | Edit </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td></td>
                <td>Data hasnt been loaded</td>
                <td></td>
                <td></td>
            </tr>
        }
    </tbody>
</table>