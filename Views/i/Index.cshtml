@model IEnumerable<WebApp.Itm>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_L-i";
    ViewData["Title"] = "<>...</>";
}
<a class="btn btn-primary" asp-controller="h" asp-action="Index">Return To Main Page</a>
<h2>Products</h2>
<div>
        <a asp-controller="I" asp-action="Add" class="btn btn-primary">Create</a>
</div>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Image</th>
            <th scope="col">Name</th>
            <th scope="col">Price</th>
            <th scope="col">Decription</th>
            <th scope="col">Tools</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                string base64String = (item.Image == null) ? "" : Convert.ToBase64String(item.Image);
                string form = (item.ImgFormat == null) ? "" : item.ImgFormat;
                var imgSrc = $"data:image/{form};base64,{base64String}";
                <tr>
                    <td>@item.Id</td>
                    <td><img src="@imgSrc" width="100" height="100" /></td>
                    <td>@item.Name</td>
                    @if (item.SalePerc > 0)
                    {
                        <td><p style="text-decoration:line-through; color:red">@item.OldPrice</p><p style="color:yellow">@item.Price</p></td>
                    }
                    else if (item.Price == 0)
                    {
                        <td><p style="text-decoration:line-through; color:red">@item.OldPrice</p><p style="color:green">Free</p></td>
                    }
                    else
                    {
                        <td>@item.Price</td>
                    }
                    <td>@item.Description</td>
                    <td>
                        <a href="/I/Det/@item.Id" class="btn btn-sm btn-success">Details</a>
                        @if (true/*User.Identity.IsAuthenticated && (User.IsInRole("admin") || User.IsInRole("root"))*/)
                        {
                            <a href="/I/Upd/@item.Id" class="btn btn-sm btn-warning">Update</a>
                            <a href="/I/Del/@item.Id" class="btn btn-sm btn-danger">Delete</a>
                        }
                    </td>
                </tr>
            }
        }
        else{
            <tr>
                <td></td>
                <td>Data hasnt been loaded</td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
        }
    </tbody>
</table>