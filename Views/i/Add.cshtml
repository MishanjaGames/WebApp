@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model WebApp.Itm

@{
    Layout = "_L-i";
    ViewData["Title"] = "Create Product";
}
<h2>Create Product</h2>
<a class="btn btn-primary" asp-controller="I" asp-action="Index">Return to table</a>
<div>
    <form enctype="multipart/form-data" id="form" asp-controller="I" asp-action="Add" method="post">
        <div class="form-group">
            <label asp-for="Name">Name</label>
            <input name="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Price">Price</label>
            <input name="Price" class="form-control" />
            <!--<span asp-validation-for="Price" class="text-danger"></span>-->
        </div>
        <div class="form-group">
            <label asp-for="SalePerc">Sale Percent</label>
            <input name="SalePerc" class="form-control" />
            <!--<span asp-validation-for="Price" class="text-danger"></span>-->
        </div>
        <div class="form-group">
            <label asp-for="Description">Description</label>
            <textarea name="Description" class="form-control"></textarea>
            <!--<span asp-validation-for="Description" class="text-danger"></span>-->
        </div>
        <div class="form-group">
            <label for="Image" class="control-label">Image</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*" />
        </div>
        <div class="form-group">
            <label asp-for="IsAvaliable">Is Avaliable</label>
            <input type="checkbox" asp-for="Description" name="IsAvaliable" class="form-control"></input>
            <!--<span asp-validation-for="Description" class="text-danger"></span>-->
        </div>
        <button type="submit" class="btn btn-primary">Create</button>
    </form>
</div>